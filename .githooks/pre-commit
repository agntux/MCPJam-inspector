#!/bin/bash
# AgntUX Pre-commit Hook
# Validates fork conventions before committing

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ERRORS=0
WARNINGS=0

error() { echo -e "${RED}[ERROR]${NC} $1"; ERRORS=$((ERRORS + 1)); }
warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; WARNINGS=$((WARNINGS + 1)); }
ok()    { echo -e "${GREEN}[OK]${NC} $1"; }

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Check 1: No .env files (except .env.example and .env.production)
echo "Checking for .env files..."
ENV_FILES=$(echo "$STAGED_FILES" | grep -E '\.env($|\.)' | grep -v '\.env\.example$' | grep -v '\.env\.production$' || true)
if [ -n "$ENV_FILES" ]; then
  for f in $ENV_FILES; do
    error "Blocked .env file: $f"
  done
else
  ok "No .env files staged."
fi

# Check 2: No API key patterns in staged content
echo "Checking for API key patterns..."
for file in $STAGED_FILES; do
  # Skip binary files
  if file "$file" | grep -q "binary"; then
    continue
  fi
  # Check staged content of the file for API key patterns
  MATCHES=$(git diff --cached -- "$file" | grep -E '^\+' | grep -v '^\+\+\+' | grep -oE '(sk-[a-zA-Z0-9]{20,}|key_[a-zA-Z0-9]{20,})' || true)
  if [ -n "$MATCHES" ]; then
    error "Possible API key found in $file"
  fi
done
if [ $ERRORS -eq 0 ]; then
  ok "No API key patterns detected."
fi

# Check 3: AgntUX markers in core files
echo "Checking AgntUX markers in core files..."
CORE_FILES=(
  "mcpjam-inspector/server/index.ts"
  "mcpjam-inspector/server/middleware/session-auth.ts"
  "mcpjam-inspector/server/routes/mcp/chat-v2.ts"
  "mcpjam-inspector/client/src/main.tsx"
  "mcpjam-inspector/client/src/hooks/use-chat-session.ts"
  "mcpjam-inspector/client/src/components/chat-v2/shared/model-helpers.ts"
)

for core_file in "${CORE_FILES[@]}"; do
  if echo "$STAGED_FILES" | grep -q "^${core_file}$"; then
    if [ -f "$core_file" ]; then
      if ! grep -q "AgntUX" "$core_file"; then
        warn "Modified core file lacks AgntUX marker: $core_file"
      fi
    fi
  fi
done

# Summary
echo ""
if [ $ERRORS -gt 0 ]; then
  echo -e "${RED}Pre-commit check FAILED: $ERRORS error(s), $WARNINGS warning(s)${NC}"
  exit 1
fi

if [ $WARNINGS -gt 0 ]; then
  echo -e "${YELLOW}Pre-commit check passed with $WARNINGS warning(s)${NC}"
fi

if [ $ERRORS -eq 0 ] && [ $WARNINGS -eq 0 ]; then
  echo -e "${GREEN}Pre-commit check passed.${NC}"
fi

exit 0
