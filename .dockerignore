**/dist
**/.cache
**/.parcel-cache

# Test files
**/__tests__
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Documentation
*.md
!README.md

# IDE
.vscode
.idea
*.swp
*.swo

# Misc
*.tgz
*.tar.gz
