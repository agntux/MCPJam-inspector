# MCPJam Inspector with Playwright for AgntUX Visual Testing
# Based on Playwright image for browser automation support
# Playwright version must match @playwright/test in package.json

FROM mcr.microsoft.com/playwright:v1.54.2-jammy

# Install Node.js 20 (Playwright image has curl pre-installed)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g npm@latest

# The Playwright image already has a user with UID/GID 1000 (pwuser).
# We reuse it for security (non-root runtime).

WORKDIR /app

# Copy SDK first (it's a dependency)
COPY --chown=1000:1000 sdk/package*.json ./sdk/
RUN cd sdk && npm ci --legacy-peer-deps

COPY --chown=1000:1000 sdk/ ./sdk/
RUN cd sdk && npm run build

# Copy MCPJam Inspector
COPY --chown=1000:1000 mcpjam-inspector/package*.json ./mcpjam-inspector/
RUN cd mcpjam-inspector && npm ci --legacy-peer-deps

COPY --chown=1000:1000 mcpjam-inspector/ ./mcpjam-inspector/

# Set VITE_MCPJAM_HOSTED_MODE at build time so the client knows it's in hosted mode
ENV VITE_MCPJAM_HOSTED_MODE=true

# Build the inspector
RUN cd mcpjam-inspector && npm run build

# Switch to non-root user (UID 1000 from Playwright image)
USER 1000

WORKDIR /app/mcpjam-inspector

# Environment
ENV NODE_ENV=production
ENV AGNTUX_MODE=true
ENV PORT=6274
ENV DOCKER_CONTAINER=true

EXPOSE 6274

# Health check using main server endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:6274/health || exit 1

CMD ["node", "dist/server/index.js"]
